{
  "name": "bank-dashboards",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "import-schema": "node packages/import-schema/src/cli.js",
    "business-context": "node packages/business-context/src/cli.js",
    "test": "npm test --workspaces --if-present",
    "lint:registry": "node packages/registry-lint/bin/lint.js",
    "data-dictionary": "node packages/semantic-query/bin/data-dictionary.js",
    "verify": "node packages/semantic-query/bin/verify.js",
    "docs:app": "node docs/build-architecture.js"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
