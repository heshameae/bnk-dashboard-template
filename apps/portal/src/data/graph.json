      "id": "kpi.casa_balance",
      "status": "CONFIRMED",
      "meaning": "Total CASA balance at close of the last business day, dormant accounts excluded",
      "owner": "head_of_treasury",
      "view": "v_balances_daily",
      "formula": "SUM(balance_amount)",
      "aggregation": "balance-last-day",
      "filters": [
